# contorell 環境變數範本
# 複製為 .env 後填入實際值。.env 已列入 .gitignore，絕不可進版控。

# === 應用程式 ===
APP_ENV=development
# 網頁對外綁定位址（Docker 模式）。預設 127.0.0.1＝只有本機能連。
# 要讓「其他網段的 IP」連進來，改成 0.0.0.0（並開放防火牆 8000 埠）。
# ⚠️ 直接暴露的是明文 HTTP，僅適合受信任內網測試；正式環境請走 HTTPS 反向代理。
APP_BIND=127.0.0.1
# 用於 session 簽章與資料加密的主金鑰。
# 產生方式： python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY

# === 資料庫 ===
DATABASE_URL=postgresql+psycopg://contorell:CHANGE_ME@db:5432/contorell
POSTGRES_USER=contorell
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=contorell

# === AD / LDAP 預設連線（亦可於 UI 設定，此處為啟動預設值）===
# 一律使用 LDAPS(636) 或 StartTLS，禁止明文 389（NFR-04）
LDAP_HOST=addc.example.local
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_BASE_DN=DC=example,DC=local
# 唯讀服務帳號（最小權限，非 Domain Admin — NFR-06）
LDAP_BIND_DN=CN=svc-contorell,OU=ServiceAccounts,DC=example,DC=local
LDAP_BIND_PASSWORD=CHANGE_ME
# 憑證驗證：正式環境務必為 true（IR-06）
LDAP_VERIFY_CERT=true
# 企業自簽 CA 憑證路徑（選填）
LDAP_CA_CERT_FILE=

# === 本地管理員退路帳號（AD 故障時使用 — FR-13b）===
# 首次啟動時建立；密碼以 argon2 雜湊儲存
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === 測試環境（Samba AD DC 模擬）===
SAMBA_DOMAIN=EXAMPLE
SAMBA_REALM=EXAMPLE.LOCAL
SAMBA_ADMIN_PASSWORD=CHANGE_ME_Passw0rd
